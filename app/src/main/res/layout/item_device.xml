<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="12dp"
    android:padding="16dp">

    <!-- Top row: name + status chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Device"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_offline"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="OFFLINE"
            android:textColor="@color/offline"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Meta line: enrollment • last seen • battery -->
    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="enrollment • last seen"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <!-- Current app -->
    <TextView
        android:id="@+id/appLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="App: —"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Location + lock badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/locLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 location"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lockBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="🔒 Locked"
            android:textColor="@color/offline"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tap for actions"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
